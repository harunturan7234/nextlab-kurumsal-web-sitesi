Options -Indexes
DirectoryIndex index.php
RewriteEngine On

# Only index.php and the public assets directory are web entry points.
RewriteRule ^(?:app|data|lib|services|views|source-assets|scripts|qa|node_modules|var)(?:/|$) - [F,L,NC]
RewriteRule (^|/)\. - [F,L]
RewriteRule \.(?:sql|json|lock|md|ejs|cjs|log|env|bak)$ - [F,L,NC]
RewriteRule ^(?:config(?:\.example)?|router)\.php$ - [F,L,NC]
RewriteRule ^(?:server|preview-server)\.js$ - [F,L,NC]
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^robots\.txt$ index.php [L]
RewriteRule ^assets/.*\.(?:css|js|png|jpe?g|webp|avif|svg|ico)$ - [L,NC]
RewriteRule ^assets/ - [R=404,L]
# Kurulum sihirbazı (kurulumdan sonra kendini kilitler)
RewriteRule ^kurulum\.php$ - [L]
# Yönetim paneli — /admin ve alt yolları tek giriş noktasına
RewriteRule ^admin/index\.php$ - [L]
RewriteRule ^admin(?:/.*)?$ admin/index.php [QSA,L]
RewriteRule ^index\.php$ - [L]
RewriteRule ^ index.php [QSA,L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(webp|avif|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml
</IfModule>
