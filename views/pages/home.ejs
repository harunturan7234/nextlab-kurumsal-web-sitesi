<section class="hero-showcase" data-slider aria-label="Nextlab öne çıkan ürün serileri">
    <div class="hero-slides-wrapper">
        <% banners.forEach((banner, index) => { %>
        <article class="hero-slide <%= index === 0 ? 'is-active' : '' %>" data-slide="<%= index %>" aria-hidden="<%= index === 0 ? 'false' : 'true' %>">
            <a href="<%= url(banner.button_url) %>" class="hero-slide-link" aria-label="<%= banner.title %>">
                <img 
                    src="<%= asset(banner.image_path) %>" 
                    alt="<%= banner.title %> - <%= banner.subtitle %>" 
                    class="hero-slide-media" 
                    width="1600" 
                    height="700" 
                    loading="<%= index === 0 ? 'eager' : 'lazy' %>"
                    referrerpolicy="no-referrer"
                />
            </a>
            <div class="hero-slide-floating-bar">
                <a class="hero-slide-pill" href="<%= url(banner.button_url) %>">
                    <span class="hero-pill-dot"></span>
                    <span class="hero-pill-text"><%= banner.badge %></span>
                    <span class="hero-pill-action"><%= banner.button_text %> →</span>
                </a>
                <% if (banner.secondary_url) { %>
                <a class="hero-slide-market" href="<%= banner.secondary_url %>" target="_blank" rel="noopener noreferrer sponsored">
                    <%= banner.secondary_text %>
                </a>
                <% } %>
            </div>
        </article>
        <% }) %>
    </div>
    
    <button class="hero-nav-arrow hero-prev" type="button" aria-label="Önceki Görsel">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>
    <button class="hero-nav-arrow hero-next" type="button" aria-label="Sonraki Görsel">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>

    <div class="slider-dots" role="tablist" aria-label="Slayt seçimi">
        <% banners.forEach((banner, index) => { %>
        <button class="<%= index === 0 ? 'active' : '' %>" type="button" aria-label="<%= index + 1 %>. slayt: <%= banner.title %>"></button>
        <% }) %>
    </div>
</section>
<section class="section categories-section">
    <div class="container">
        <div class="section-heading"><span>ÜRÜN AİLEMİZ</span><h2>Kategoriler</h2><p>İhtiyacınıza uygun Nextlab ürün grubunu keşfedin.</p></div>
        <div class="category-grid">
            <% categories.forEach(category => { %>
                <%- include('../components/category-card', { category }) %>
            <% }) %>
        </div>
    </div>
</section>
<section class="section featured-section">
    <div class="container">
        <div class="section-heading row-heading"><div><span>ÖNE ÇIKANLAR</span><h2>Seçili Ürünler</h2></div><a class="outline-button" href="<%= url('urunler') %>">Tüm Ürünler</a></div>
        <div class="product-grid">
            <% featuredProducts.forEach(product => { %>
                <%- include('../components/product-card', { product }) %>
            <% }) %>
        </div>
    </div>
</section>
<section class="brand-family section">
    <div class="container brand-family-grid">
        <div><span class="eyebrow dark">ÜRÜN AİLELERİ</span><h2>İki odak, yalın bir ürün yaklaşımı</h2><p>Everyday günlük cilt ve kişisel bakım ürünlerini; NextLab ise ortam kokulandırma çözümlerini bir araya getirir.</p></div>
        <div class="brand-tile everyday"><strong>everyday</strong><span>Günlük bakım ürünleri</span><a href="<%= url('kategori/kozmetik-ve-kisisel-bakim') %>">Ürünleri keşfet →</a></div>
        <div class="brand-tile nextlab"><strong>NEXTLAB</strong><span>Ortam kokulandırma</span><a href="<%= url('kategori/ortam-kokulandirma') %>">Koleksiyonu incele →</a></div>
    </div>
</section>
<section class="approach section">
    <div class="container content-split">
        <div class="approach-visual"><span>LESS</span><b>IS MORE</b></div>
        <div class="prose"><span class="eyebrow dark">MARKA YAKLAŞIMI</span><h2>Az içerikle, anlaşılır bakım.</h2><p>Nextlab Cosmetic, cilt sağlığına yönelik çözüm odaklı ürünler geliştirmeyi; sade ve anlaşılır içerik iletişimini merkeze alır.</p><p>Everyday ürün ailesi günlük kullanıma odaklanırken, marka bilinçli cilt bakımı alışkanlıklarını destekleyen açık bir iletişim hedefler.</p><a class="text-link" href="<%= url('hakkimizda') %>">Nextlab’ı tanıyın →</a></div>
    </div>
</section>
<% if (typeof latestBlogs !== 'undefined' && latestBlogs && latestBlogs.length > 0) { %>
<section class="section home-blog-section" aria-label="Güncel blog yazıları">
    <div class="container">
        <div class="section-heading row-heading">
            <div>
                <span>EDİTÖRYAL &amp; BİLİMSEL İÇERİK</span>
                <h2>Cilt Bakımı &amp; Kozmetik Rehberi</h2>
            </div>
            <a class="outline-button" href="<%= url('blog') %>">Tüm Blog Yazıları (6) →</a>
        </div>
        <div class="blog-grid-cards">
            <% latestBlogs.forEach(article => { %>
            <article class="blog-card" aria-label="<%= article.title %>">
                <div class="card-media-wrap">
                    <a href="<%= url('blog/' + article.slug) %>" aria-label="<%= article.title %> yazısını oku">
                        <img 
                            src="<%= asset(article.image_path) %>" 
                            alt="<%= article.image_alt %>" 
                            width="800" 
                            height="500" 
                            loading="lazy"
                            class="card-cover-img"
                        >
                    </a>
                </div>
                <div class="card-body">
                    <h3 class="card-title">
                        <a href="<%= url('blog/' + article.slug) %>"><%= article.title %></a>
                    </h3>
                </div>
            </article>
            <% }) %>
        </div>
    </div>
</section>
<% } %>
<section class="faq-section" id="sss" aria-label="Sıkça Sorulan Sorular">
    <div class="container">
        <div class="faq-header">
            <h2 class="faq-title">Sıkça Sorulan Sorular</h2>
        </div>

        <% 
            const allFaqs = (faqs || []);
            const mid = Math.ceil(allFaqs.length / 2);
            const leftCol = allFaqs.slice(0, mid);
            const rightCol = allFaqs.slice(mid);
        %>

        <div class="faq-grid-2col" data-faq-accordion>
            <div class="faq-col">
                <% leftCol.forEach((faq, idx) => { %>
                <details class="faq-card-item" <%= idx === 0 ? 'open' : '' %>>
                    <summary class="faq-card-summary">
                        <span class="faq-plus-icon" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#d71920" stroke-width="3.4" stroke-linecap="round">
                                <line x1="12" y1="4" x2="12" y2="20"></line>
                                <line x1="4" y1="12" x2="20" y2="12"></line>
                            </svg>
                        </span>
                        <h3 class="faq-card-title"><%= faq.question %></h3>
                    </summary>
                    <div class="faq-card-body">
                        <p class="faq-card-text"><%= faq.answer %></p>
                    </div>
                </details>
                <% }) %>
            </div>
            <div class="faq-col">
                <% rightCol.forEach((faq) => { %>
                <details class="faq-card-item">
                    <summary class="faq-card-summary">
                        <span class="faq-plus-icon" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#d71920" stroke-width="3.4" stroke-linecap="round">
                                <line x1="12" y1="4" x2="12" y2="20"></line>
                                <line x1="4" y1="12" x2="20" y2="12"></line>
                            </svg>
                        </span>
                        <h3 class="faq-card-title"><%= faq.question %></h3>
                    </summary>
                    <div class="faq-card-body">
                        <p class="faq-card-text"><%= faq.answer %></p>
                    </div>
                </details>
                <% }) %>
            </div>
        </div>
    </div>
</section>
<section class="location-section" aria-label="NextLab konumu">
    <a class="map-link" href="https://www.google.com/maps/search/?api=1&amp;query=NextLab+Sa%C4%9Fl%C4%B1k+Kozmetik%2C+Altunizade%2C+%C3%9Cniversite+Sok.+No%3A7%2F1%2C+34674+%C3%9Csk%C3%BCdar%2F%C4%B0stanbul" target="_blank" rel="noopener noreferrer" aria-label="NextLab Sağlık Kozmetik işletmesini Google Maps'te aç">
        <iframe title="NextLab Sağlık Kozmetik konumu" src="https://www.google.com/maps?q=NextLab%20Sa%C4%9Fl%C4%B1k%20Kozmetik%2C%20Altunizade%2C%20%C3%9Cniversite%20Sok.%20No%3A7%2F1%2C%2034674%20%C3%9Csk%C3%BCdar%2F%C4%B0stanbul&amp;output=embed" width="100%" height="300" loading="lazy" referrerpolicy="no-referrer-when-downgrade" tabindex="-1"></iframe>
        <span>Haritada Aç ↗</span>
    </a>
</section>
