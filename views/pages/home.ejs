<section class="hero-showcase" data-slider aria-roledescription="karusel" aria-label="Nextlab ürün dünyası">
    <div class="hero-slides-wrapper">
        <% banners.forEach((banner, index) => { %>
        <article class="hero-slide hero-<%= banner.theme %> <%= index === 0 ? 'is-active' : '' %>" data-slide="<%= index %>" aria-hidden="<%= index !== 0 %>" <%= index !== 0 ? 'inert' : '' %>>
            <div class="container hero-composition">
                <div class="hero-copy">
                    <span class="hero-eyebrow"><span></span><%= banner.badge %></span>
                    <% if (index === 0) { %><h1><%= banner.title %></h1><% } else { %><h2><%= banner.title %></h2><% } %>
                    <p><%= banner.subtitle %></p>
                    <div class="hero-actions">
                        <a class="button" href="<%= url(banner.button_url) %>"><%= banner.button_text %> <span aria-hidden="true">↗</span></a>
                        <% if (banner.secondary_url) { %><a class="hero-secondary" href="<%= banner.secondary_url %>" target="_blank" rel="noopener noreferrer"><%= banner.secondary_text %></a><% } %>
                    </div>
                    <span class="hero-counter">0<%= index + 1 %> <span>/ 03</span></span>
                </div>
                <% if (banner.image_path) { %>
                <div class="hero-photo">
                    <picture>
                        <source media="(max-width: 680px)" srcset="<%= asset('images/verified/ceymop-temizlik-mobil-480.webp') %> 480w, <%= asset('images/verified/ceymop-temizlik-mobil-768.webp') %> 768w" sizes="100vw">
                        <img src="<%= asset(banner.image_path) %>" srcset="<%= mediaSrcset(banner.image_path) %>" sizes="(max-width: 680px) 100vw, 56vw" width="1920" height="650" alt="Ceymop referansından profesyonel temizlik ekipmanları" loading="lazy">
                    </picture>
                    <span class="photo-credit">CEYMOP • Profesyonel temizlik ekipmanları</span>
                </div>
                <% } else { %>
                <div class="hero-product-composition">
                    <% bannerProducts(banner).forEach(item => { %>
                    <a class="hero-product" href="<%= url('urun/' + item.slug) %>">
                        <%- imageTag(item.image_path, item.name, { sizes: '(max-width: 680px) 30vw, 18vw', priority: index === 0 }) %>
                        <span><b><%= item.brand_name %></b><%= item.name.replace(/^Everyday /, '') %></span>
                    </a>
                    <% }) %>
                </div>
                <% } %>
            </div>
        </article>
        <% }) %>
    </div>
    <div class="slider-controls">
        <button class="hero-nav-arrow hero-prev" type="button" aria-label="Önceki slayt">←</button>
        <div class="slider-dots" role="group" aria-label="Slayt seçimi">
            <% banners.forEach((banner, index) => { %>
            <button class="<%= index === 0 ? 'active' : '' %>" type="button" aria-current="<%= index === 0 ? 'true' : 'false' %>" aria-label="<%= index + 1 %>. slayt: <%= banner.title %>"><span></span></button>
            <% }) %>
        </div>
        <button class="hero-nav-arrow hero-next" type="button" aria-label="Sonraki slayt">→</button>
        <button class="slider-pause" type="button" aria-pressed="true" aria-label="Slaytları otomatik oynat">Oynat</button>
    </div>
</section>
<section class="section categories-section">
    <div class="container">
        <div class="section-heading"><span>ÜRÜN AİLEMİZ</span><h2>Kategoriler</h2><p>İhtiyacınıza uygun ürünleri, kendi marka kimlikleriyle keşfedin.</p></div>
        <div class="category-grid">
            <% categories.forEach(category => { %>
                <%- include('../components/category-card', { category }) %>
            <% }) %>
        </div>
    </div>
</section>
<section class="section featured-section">
    <div class="container">
        <div class="section-heading row-heading"><div><span>ÖNE ÇIKANLAR</span><h2>Seçili Ürünler</h2></div><a class="outline-button" href="<%= url('urunler') %>">Tüm Ürünler</a></div>
        <div class="product-grid">
            <% featuredProducts.forEach(product => { %>
                <%- include('../components/product-card', { product }) %>
            <% }) %>
        </div>
    </div>
</section>
<section class="brand-family section">
    <div class="container brand-family-grid">
        <div><span class="eyebrow dark">ÜRÜN AİLELERİ</span><h2>İki odak, yalın bir ürün yaklaşımı</h2><p>Everyday günlük cilt ve kişisel bakım ürünlerini; NextLab ise ortam kokulandırma çözümlerini bir araya getirir.</p></div>
        <div class="brand-tile everyday"><strong>everyday</strong><span>Günlük bakım ürünleri</span><a href="<%= url('kategori/kozmetik-ve-kisisel-bakim') %>">Ürünleri keşfet →</a></div>
        <div class="brand-tile nextlab"><strong>NEXTLAB</strong><span>Ortam kokulandırma</span><a href="<%= url('kategori/ortam-kokulandirma') %>">Koleksiyonu incele →</a></div>
    </div>
</section>
<section class="approach section">
    <div class="container content-split">
        <div class="approach-visual"><span>LESS</span><b>IS MORE</b></div>
        <div class="prose"><span class="eyebrow dark">MARKA YAKLAŞIMI</span><h2>Az içerikle, anlaşılır bakım.</h2><p>Nextlab Cosmetic, cilt sağlığına yönelik çözüm odaklı ürünler geliştirmeyi; sade ve anlaşılır içerik iletişimini merkeze alır.</p><p>Everyday ürün ailesi günlük kullanıma odaklanırken, marka bilinçli cilt bakımı alışkanlıklarını destekleyen açık bir iletişim hedefler.</p><a class="text-link" href="<%= url('hakkimizda') %>">Nextlab’ı tanıyın →</a></div>
    </div>
</section>
<% if (typeof latestBlogs !== 'undefined' && latestBlogs && latestBlogs.length > 0) { %>
<section class="section home-blog-section" aria-label="Güncel blog yazıları">
    <div class="container">
        <div class="section-heading row-heading">
            <div>
                <span>NEXTLAB REHBERİ</span>
                <h2>Ürünler &amp; Yaşam Alanları</h2>
            </div>
            <a class="outline-button" href="<%= url('blog') %>">Tüm Blog Yazıları (6) →</a>
        </div>
        <div class="blog-grid-cards">
            <% latestBlogs.forEach(article => { %>
            <article class="blog-card" aria-label="<%= article.title %>">
                <div class="card-media-wrap">
                    <a href="<%= url('blog/' + article.slug) %>" aria-label="<%= article.title %> yazısını oku">
                        <% if (article.image_path) { %><%- imageTag(article.image_path, article.image_alt, { sizes: '(max-width: 680px) 92vw, 400px' }) %><% } else { %><span class="blog-editorial-cover"><small>NEXTLAB REHBERİ</small><strong><%= article.category %></strong></span><% } %>" 
                            width="800" 
                            height="500" 
                            loading="lazy"
                            class="card-cover-img"
                        >
                    </a>
                </div>
                <div class="card-body">
                    <h3 class="card-title">
                        <a href="<%= url('blog/' + article.slug) %>"><%= article.title %></a>
                    </h3>
                </div>
            </article>
            <% }) %>
        </div>
    </div>
</section>
<% } %>
<section class="faq-section" id="sss" aria-label="Sıkça Sorulan Sorular">
    <div class="container">
        <div class="faq-header">
            <h2 class="faq-title">Sıkça Sorulan Sorular</h2>
        </div>

        <% 
            const allFaqs = (faqs || []);
            const mid = Math.ceil(allFaqs.length / 2);
            const leftCol = allFaqs.slice(0, mid);
            const rightCol = allFaqs.slice(mid);
        %>

        <div class="faq-grid-2col" data-faq-accordion>
            <div class="faq-col">
                <% leftCol.forEach((faq, idx) => { %>
                <details class="faq-card-item" <%= idx === 0 ? 'open' : '' %>>
                    <summary class="faq-card-summary">
                        <span class="faq-plus-icon" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#d71920" stroke-width="3.4" stroke-linecap="round">
                                <line x1="12" y1="4" x2="12" y2="20"></line>
                                <line x1="4" y1="12" x2="20" y2="12"></line>
                            </svg>
                        </span>
                        <h3 class="faq-card-title"><%= faq.question %></h3>
                    </summary>
                    <div class="faq-card-body">
                        <p class="faq-card-text"><%= faq.answer %></p>
                    </div>
                </details>
                <% }) %>
            </div>
            <div class="faq-col">
                <% rightCol.forEach((faq) => { %>
                <details class="faq-card-item">
                    <summary class="faq-card-summary">
                        <span class="faq-plus-icon" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#d71920" stroke-width="3.4" stroke-linecap="round">
                                <line x1="12" y1="4" x2="12" y2="20"></line>
                                <line x1="4" y1="12" x2="20" y2="12"></line>
                            </svg>
                        </span>
                        <h3 class="faq-card-title"><%= faq.question %></h3>
                    </summary>
                    <div class="faq-card-body">
                        <p class="faq-card-text"><%= faq.answer %></p>
                    </div>
                </details>
                <% }) %>
            </div>
        </div>
    </div>
</section>
<section class="location-section" aria-label="Nextlab konumu"><div class="container location-card"><div><span class="eyebrow dark">İSTANBUL • ÜSKÜDAR</span><h2>İhtiyaçlarınızı birlikte konuşalım.</h2><p>Üniversite Sokak No: 7/B, Işık Plaza<br>Altunizade, Üsküdar / İstanbul</p></div><a class="outline-button" href="https://www.google.com/maps/search/?api=1&amp;query=Nextlab+Universite+Sokak+7%2FB+Altunizade+Uskudar" target="_blank" rel="noopener noreferrer">Haritada Aç ↗</a></div></section>
