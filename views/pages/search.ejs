<section class="page-hero"><div class="container"><h1>Ürün Arama</h1><%- include('../components/breadcrumb', { items: [{ label: 'Arama' }] }) %></div></section>
<section class="section"><div class="container"><form class="search-page-form" action="<%= url('arama') %>"><input type="search" aria-label="Ürün adı veya kodu" name="q" value="<%= query %>" minlength="2" placeholder="Ürün adı veya kodu" required><button class="button">Ara</button></form><% if (query !== '') { %><h2 class="result-title">“<%= query %>” için <%= products.length %> sonuç</h2><div class="product-grid"><% products.forEach(product => { %><%- include('../components/product-card', { product }) %><% }) %></div><% } %></div></section>
