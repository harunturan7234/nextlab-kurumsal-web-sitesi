<section class="page-hero">
    <div class="container">
        <h1>Blog</h1>
        <%- include('../components/breadcrumb', { items: [{ label: 'Blog' }] }) %>
    </div>
</section>

<section class="section blog-listing-section">
    <div class="container">
        <% if (typeof categories !== 'undefined' && categories && categories.length > 0) { %>
        <!-- Blog Kategori Filtreleri -->
        <div class="blog-category-filter" role="tablist" aria-label="Blog kategorileri">
            <% categories.forEach(cat => { 
                const isActive = (currentCategory === cat.slug) || (!currentCategory && cat.slug === 'all');
            %>
            <a 
                href="<%= url(cat.slug === 'all' ? 'blog' : 'blog?kategori=' + cat.slug) %>" 
                class="blog-filter-btn <%= isActive ? 'is-active' : '' %>"
                role="tab"
                aria-selected="<%= isActive ? 'true' : 'false' %>"
            >
                <%= cat.name %>
            </a>
            <% }) %>
        </div>
        <% } %>
        <% if (!blogs || blogs.length === 0) { %>
            <div class="blog-empty-state">
                <p>Seçilen kategoride henüz yazı bulunmamaktadır.</p>
                <a href="<%= url('blog') %>" class="primary-button">Tüm Yazıları Görüntüle</a>
            </div>
        <% } else { %>
            
            <!-- Clean, Compact 3-Column Editorial Grid -->
            <div class="blog-grid-cards">
                <% blogs.forEach(article => { %>
                <article class="blog-card" aria-label="<%= article.title %>">
                    <div class="card-media-wrap">
                        <a href="<%= url('blog/' + article.slug) %>" aria-label="<%= article.title %> yazısını oku">
                            <% if (article.image_path) { %><%- imageTag(article.image_path, article.image_alt, { sizes: '(max-width: 680px) 92vw, 400px' }) %><% } else { %><span class="blog-editorial-cover"><small>NEXTLAB REHBERİ</small><strong><%= article.category %></strong></span><% } %>" 
                                width="800" 
                                height="500"
                                loading="lazy"
                                class="card-cover-img"
                            >
                        </a>
                    </div>

                    <div class="card-body">
                        <h2 class="card-title">
                            <a href="<%= url('blog/' + article.slug) %>"><%= article.title %></a>
                        </h2>
                    </div>
                </article>
                <% }) %>
            </div>

        <% } %>
    </div>
</section>

<section class="cta">
    <div class="container">
        <div>
            <span>BİLİMSEL FORMÜLASYON &amp; KURUMSAL TEDARİK</span>
            <h2>Eczane, klinik ve B2B toptan tedarik talepleriniz için uzman ekibimizle iletişime geçin.</h2>
        </div>
        <a class="button light" href="<%= url('iletisim') %>">Kurumsal İletişim →</a>
    </div>
</section>
