<section class="page-hero">
    <div class="container">
        <h1><%= brand.name %></h1>
        <%- include('../components/breadcrumb', { items: [
            { label: 'Markalar ve İş Birlikleri', url: 'distributorlukler' },
            { label: brand.name }
        ] }) %>
    </div>
</section>

<section class="section brand-detail-section">
    <div class="container">
        <div class="brand-detail-layout">
            <div class="brand-detail-main">
                <div class="brand-intro-card">
                    <div class="brand-origin-pill">
                        <span class="flag-dot"></span> <%= brand.origin %> &bull; <%= brand.category %>
                    </div>
                    <h2><%= brand.name %> Marka Bilgileri</h2>
                    <p class="brand-highlight-lead"><%= brand.highlight %></p>
                    <p class="brand-full-desc"><%= brand.description %></p>

                    <p class="image-note">Marka rehberi kaydı, yetkili distribütörlük beyanı değildir. Güncel iş birliği ve tedarik bilgileri için bize ulaşın.</p>
                </div>

                <div class="brand-products-block">
                    <span class="eyebrow dark">ÖNE ÇIKAN SERİLER</span>
                    <h3><%= brand.name %> Popüler Ürün Gamı</h3>
                    <div class="brand-hero-products-grid">
                        <% brand.key_products.forEach((prod, i) => { %>
                        <div class="prod-showcase-tile">
                            <div class="prod-num">0<%= i + 1 %></div>
                            <h4><%= prod %></h4>
                            <p>Ürün grubunu ve teknik ayrıntıları kataloğumuzdan inceleyebilirsiniz.</p>
                            <span class="prod-tag"><%= brand.badges[i % brand.badges.length] %></span>
                        </div>
                        <% }) %>
                    </div>
                </div>
            </div>

            <aside class="brand-detail-sidebar">
                <div class="b2b-contact-card">
                    <h3>Kurumsal Tedarik</h3>
                    <p><%= brand.name %> ürünlerini eczanenizde, kliniğinizde veya mağazanızda satışa sunmak için toptan sipariş ve bayi fiyat listesi talep edebilirsiniz.</p>

                    <a class="button w-full" href="<%= url('iletisim') %>">Toptan / Bayilik İletişimi</a>
                </div>

                <div class="other-brands-card">
                    <h4>Diğer Markalar</h4>
                    <ul class="other-brands-list">
                        <% (allBrands || []).filter(b => b.slug !== brand.slug).slice(0, 6).forEach(other => { %>
                        <li>
                            <a href="<%= url('distributorluk/' + other.slug) %>">
                                <strong><%= other.name %></strong>
                                <span><%= other.category %></span>
                            </a>
                        </li>
                        <% }) %>
                    </ul>
                    <a class="text-link" href="<%= url('distributorlukler') %>" style="margin-top: 14px; display: inline-block;">Tüm Markaları Gör →</a>
                </div>
            </aside>
        </div>
    </div>
</section>
