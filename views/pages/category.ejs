<section class="page-hero"><div class="container"><h1><%= category.name %></h1><%- include('../components/breadcrumb', { items: [{ label: 'Ürünler', url: url('urunler') }, { label: category.name }] }) %></div></section>
<section class="section"><div class="container catalog-layout"><aside class="category-sidebar"><h2>Kategoriler</h2><nav><% categories.forEach(item => { %><a class="<%= item.slug === category.slug ? 'active' : '' %>" href="<%= url('kategori/' + item.slug) %>"><%= item.name %><span>›</span></a><% }) %></nav><a class="catalog-box" href="<%= url('katalog') %>"><b>Ürün Kataloğu</b><span>Tüm ürünleri bir arada inceleyin →</span></a></aside><div class="catalog-content"><% if (typeof subCategories !== 'undefined' && subCategories && subCategories.length > 0) { %><nav class="subcategory-filter" aria-label="Alt kategoriler"><a class="active" href="<%= url('kategori/' + category.slug) %>">Tümü</a><% subCategories.forEach(sub => { %><a href="<%= url('kategori/' + sub.slug) %>"><%= sub.name %></a><% }) %></nav><% } %><div class="catalog-toolbar"><p><strong><%= products ? products.length : 0 %></strong> ürün listeleniyor</p></div><% if (products && products.length > 0) { %><div class="product-grid three-col"><% products.forEach(product => { %><%- include('../components/product-card', { product }) %><% }) %></div><% } else { %><div class="empty-state"><h2>Bu kategoride henüz ürün yok.</h2><p>Yeni ürünler yakında eklenecek.</p></div><% } %></div></div></section>
