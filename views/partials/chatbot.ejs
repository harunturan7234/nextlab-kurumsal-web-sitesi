<!-- Nextlab AI Chatbot Floating Trigger & Widget -->
<div id="nextlab-chatbot-root" class="nextlab-chatbot-root" aria-live="polite">

  <!-- Floating Ask / Question Launcher Button -->
  <button type="button" id="chatbot-launcher-btn" class="chatbot-launcher-btn" aria-label="Nextlab Ürün Rehberine Soru Sor" aria-expanded="false" aria-controls="chatbot-panel" title="Soru Sorun">
    <span class="chatbot-launcher-pulse"></span>
    
    <!-- Closed Icon: Sleek Dialogue Speech Bubble with Question Mark '?' -->
    <span class="chatbot-launcher-icon icon-open">
      <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <!-- Modern conversational dialogue bubble -->
        <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22z" fill="rgba(255,255,255,0.2)" stroke="#ffffff" stroke-width="2"/>
        <!-- Clear friendly question mark inside -->
        <path d="M9.5 9.2a2.6 2.6 0 0 1 5.1.8c0 1.6-2.1 2.1-2.1 3.2" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round"/>
        <circle cx="12.5" cy="16" r="1.15" fill="#ffffff" stroke="none"/>
      </svg>
    </span>

    <!-- Active Icon: Close (X) -->
    <span class="chatbot-launcher-icon icon-close" style="display: none;">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </span>

    <!-- Subtle Online Dot -->
    <span class="chatbot-status-indicator" title="Asistan Çevrimiçi"></span>
  </button>

  <!-- Chatbot Panel Window -->
  <div id="chatbot-panel" class="chatbot-panel" role="region" aria-label="Nextlab Ürün Rehberi" style="display: none;">
    
    <!-- Header -->
    <div class="chatbot-header">
      <div class="chatbot-header-info">
        <div class="chatbot-avatar-wrap">
          <div class="chatbot-avatar">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22z" fill="rgba(255,255,255,0.25)" stroke="#ffffff"/>
              <path d="M9.8 9.5a2.2 2.2 0 0 1 4.4.6c0 1.3-1.8 1.8-1.8 2.8" stroke="#ffffff" stroke-width="2"/>
              <circle cx="12.4" cy="15.2" r="1" fill="#ffffff" stroke="none"/>
            </svg>
          </div>
          <span class="chatbot-avatar-status"></span>
        </div>
        <div class="chatbot-header-text">
          <div class="chatbot-title-row">
            <h3 class="chatbot-title">Nextlab Ürün Rehberi</h3>
            <span class="chatbot-status-pill">
              <span class="chatbot-status-dot"></span> Çevrimiçi
            </span>
          </div>
          <p class="chatbot-subtitle">Katalog ürünleri ve mağaza bağlantıları</p>
        </div>
      </div>

      <div class="chatbot-header-actions">
        <button type="button" id="chatbot-reset-btn" class="chatbot-header-btn" title="Sohbeti Temizle" aria-label="Sohbeti Temizle">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12a9 9 0 0 1 15-6.7L21 8"/>
            <path d="M21 3v5h-5"/>
            <path d="M21 12a9 9 0 0 1-15 6.7L3 16"/>
            <path d="M3 21v-5h5"/>
          </svg>
        </button>
        <button type="button" id="chatbot-close-btn" class="chatbot-header-btn" title="Kapat" aria-label="Kapat">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Quick Suggestions Bar -->
    <div class="chatbot-suggestions-section" aria-label="Örnek Sorular">
      <div class="chatbot-suggestions-label">Örnek Sorular:</div>
      <div class="chatbot-suggestions-scroll" id="chatbot-suggestions">
        <button type="button" class="chatbot-chip" data-query="Everyday sivilce bandı nasıl kullanılır?">Everyday Sivilce Bandı</button>
        <button type="button" class="chatbot-chip" data-query="Everyday bakım bantları">Everyday Bantlar</button>
        <button type="button" class="chatbot-chip" data-query="Nextlab ortam kokuları ve esans çeşitleri nelerdir?">Nextlab Ortam Kokuları</button>
        <button type="button" class="chatbot-chip" data-query="Ceymop temizlik ekipmanları">Ceymop Ürünleri</button>
      </div>
    </div>

    <!-- Messages Container -->
    <div class="chatbot-messages" id="chatbot-messages" role="log" aria-live="polite">
      <!-- Welcome Message (Minimal & Exact as requested) -->
      <div class="chatbot-msg chatbot-msg-bot">
        <div class="chatbot-msg-avatar">
          <span>NL</span>
        </div>
        <div class="chatbot-msg-body">
          <div class="chatbot-msg-sender">Nextlab Ürün Rehberi</div>
          <div class="chatbot-msg-text">
            <p>Merhaba! 👋 Ben Nextlab Ürün Rehberi. Ürünler ve mağazalar hakkında yardımcı olabilirim.</p>
          </div>
          <span class="chatbot-msg-time" data-time="now">Şimdi</span>
        </div>
      </div>
    </div>

    <!-- Typing Indicator -->
    <div class="chatbot-typing" id="chatbot-typing" style="display: none;">
      <div class="chatbot-msg-avatar">
        <span>NL</span>
      </div>
      <div class="chatbot-typing-bubble">
        <span class="typing-dot"></span>
        <span class="typing-dot"></span>
        <span class="typing-dot"></span>
      </div>
      <span class="chatbot-typing-label">Yanıt hazırlanıyor...</span>
    </div>

    <!-- Input Form -->
    <form id="chatbot-form" class="chatbot-input-form" autocomplete="off">
      <div class="chatbot-input-wrap">
        <textarea
          id="chatbot-input"
          class="chatbot-input"
          placeholder="Merak ettiğiniz soruyu buraya yazın..."
          rows="1"
          maxlength="800"
          aria-label="Sorunuzu yazın"
        ></textarea>
        <button type="submit" id="chatbot-send-btn" class="chatbot-send-btn" aria-label="Gönder" title="Gönder">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="22" y1="2" x2="11" y2="13"/>
            <polygon points="22 2 15 22 11 13 2 9 22 2"/>
          </svg>
        </button>
      </div>
      <div class="chatbot-footer-meta">
        <span class="chatbot-hint-text">Enter ile gönder, Shift + Enter ile yeni satır</span>
        <span class="chatbot-char-count" id="chatbot-char-count">0/800</span>
      </div>
    </form>

  </div>
</div>
<script defer src="<%= asset('js/chatbot.js') %>"></script>
