<!doctype html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="<%= locals.metaDescription || 'Nextlab temizlik, hijyen, kozmetik ve kişisel bakım ürünleri.' %>">
    <meta name="theme-color" content="#d71920">
    <title><%= locals.title ? `${locals.title} | Nextlab` : 'Nextlab | Temizlik ve Kişisel Bakım Ürünleri' %></title>
    <link rel="canonical" href="<%= locals.canonicalUrl || fullUrl(currentPath) %>">
    <meta property="og:type" content="<%= locals.ogType || 'website' %>">
    <meta property="og:site_name" content="Nextlab Cosmetic">
    <meta property="og:title" content="<%= locals.title ? `${locals.title} | Nextlab` : 'Nextlab Cosmetic' %>">
    <meta property="og:description" content="<%= locals.metaDescription || 'Nextlab ve Everyday ürünlerini keşfedin.' %>">
    <meta property="og:url" content="<%= fullUrl(currentPath) %>">
    <meta property="og:image" content="<%= locals.ogImage || fullUrl('assets/images/verified/nextlab-logo-1200.webp') %>">
    <meta name="twitter:card" content="summary_large_image">
    <link rel="stylesheet" href="<%= asset('css/style.css') %>">
    <link rel="stylesheet" href="<%= asset('css/professional.css') %>">
    <% if (page === 'search' || page === '404') { %><meta name="robots" content="noindex,follow"><% } %>
    <script defer src="<%= asset('js/app.js') %>"></script>
    <script type="application/ld+json"><%- JSON.stringify(locals.structuredData || {
      '@context': 'https://schema.org',
      '@type': 'Organization',
      'name': 'Nextlab Cosmetic',
      'url': fullUrl(''),
      'sameAs': [
        'https://www.instagram.com/nextlabcosmetics/',
        'https://www.linkedin.com/company/nextlabcosmetic/'
      ]
    }).replace(/</g, '\\u003c') %></script>
</head>
<body>
<a class="skip-link" href="#main-content">İçeriğe geç</a>
<%- include('partials/header') %>
<main id="main-content"><%- content %></main>
<%- include('partials/footer') %>
<%- include('partials/chatbot') %>
</body>
</html>
